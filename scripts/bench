#!/bin/bash
# Run performance benchmarks using mini.test (setup handled by
# scripts/minimal_init.lua). Targets tests/bench/ only.

NVIM=${NVIM:-nvim}
INIT=${INIT:-scripts/minimal_init.lua}

if [[ -n $1 ]]; then
  echo "Running single benchmark file: $1"
  $NVIM --headless --noplugin -u "$INIT" \
    -c "lua MiniTest_run({ collect = { find_files = function() return { '$1' } end } })"
else
  echo "Running all benchmarks"
  $NVIM --headless --noplugin -u "$INIT" \
    -c "lua MiniTest_run({ collect = { find_files = function() return vim.fn.globpath('tests/bench', '**/*_spec.lua', true, true) end } })"
fi
